{
  "manifest_version": 3,
  "name": "Bitbucket Rich Diff",
  "version": "0.1.0",
  "description": "Rendered Markdown with tracked changes and structural JSON diffs on Bitbucket pull requests.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bitbucket Rich Diff settings",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://bitbucket.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "page.css",
        "page-groups.css",
        "page-folds.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
