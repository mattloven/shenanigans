{
  "name": "bitbucket-rich-diff",
  "version": "0.1.0",
  "description": "Chrome extension: rich Markdown and JSON diffs on Bitbucket pull requests",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 --test-reporter=spec test/e2e/*.e2e.mjs",
    "package": "node scripts/build.mjs && cd dist && zip -qr ../bitbucket-rich-diff.zip ."
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "private": true
}
